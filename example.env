# ClickHouse Cluster Credentials
# For each cluster defined in config.yaml, set the following environment variables:
# {CLUSTER_NAME}_CLICKHOUSE_USERNAME and {CLUSTER_NAME}_CLICKHOUSE_PASSWORD

# Default Xatu cluster credentials
XATU_CLICKHOUSE_USERNAME=
XATU_CLICKHOUSE_PASSWORD=

# Example: Additional cluster credentials (if defined in config.local.yaml)
# MY_CLUSTER_CLICKHOUSE_USERNAME=
# MY_CLUSTER_CLICKHOUSE_PASSWORD=

# API Keys for integrations
BEACONCHAIN_API_KEY=
RATED_API_KEY=
